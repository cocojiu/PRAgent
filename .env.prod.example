BACKEND_IMAGE=ghcr.io/your-org/pragent-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/pragent-frontend:latest

COMPOSE_PROJECT_NAME=repoguard

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=repoguard
APP_MYSQL_DATABASE=repoguard
MYSQL_USER=repoguard
MYSQL_PASSWORD=change-me-db
MYSQL_VOLUME_NAME=repoguard_mysql_data

RABBITMQ_DEFAULT_USER=repoguard
RABBITMQ_DEFAULT_PASS=change-me-rabbit
RABBITMQ_DEFAULT_VHOST=/repoguard
APP_RABBITMQ_VIRTUAL_HOST=/repoguard
RABBITMQ_VOLUME_NAME=repoguard_rabbitmq_data

REPOGUARD_FRONTEND_SERVER_NAME=your-domain.example www.your-domain.example
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example
REPOGUARD_API_ENABLED=true
REPOGUARD_WORKER_ENABLED=true
# Optional split deployment:
# COMPOSE_PROFILES=worker-split
# REPOGUARD_WORKER_ENABLED=false
# WORKER_MEM_LIMIT=800m
REPOGUARD_SECURITY_ENCRYPTION_KEY=change-me-32-bytes-or-longer
REPOGUARD_SECURITY_ENCRYPTION_KEY_ID=prod-001
REPOGUARD_AUTH_TOKEN_SECRET=change-me-auth-token-secret
REPOGUARD_AUTH_REGISTRATION_ENABLED=false
REPOGUARD_AUTH_SECURE_COOKIES=true
REPOGUARD_AUTH_REFRESH_CONCURRENCY_GRACE_SECONDS=5
REPOGUARD_AUTH_REQUESTS_PER_MINUTE_PER_IP=30
REPOGUARD_AUTH_REQUESTS_PER_MINUTE_PER_ACCOUNT_IP=10
REPOGUARD_ADMIN_API_KEY=change-me-admin-api-key
REPOGUARD_ADMIN_API_KEY_ENABLED=true
REPOGUARD_GITHUB_WEBHOOK_SECRET=change-me-github-webhook-secret
REPOGUARD_GITHUB_WEBHOOK_ALLOWED_REPOSITORIES=your-org/your-repository
REPOGUARD_GITHUB_WEBHOOK_REQUIRE_SIGNATURE=true
REPOGUARD_GITHUB_WEBHOOK_MAX_PAYLOAD_BYTES=1048576
REPOGUARD_GITHUB_WEBHOOK_MAX_REQUESTS_PER_MINUTE_PER_IP=120
REPOGUARD_GITHUB_WEBHOOK_MAX_REQUESTS_PER_MINUTE_PER_REPOSITORY=60

# Add self-hosted endpoints explicitly. Private addresses also require an entry
# in REPOGUARD_OUTBOUND_PRIVATE_NETWORK_ALLOWED_HOSTS.
REPOGUARD_OUTBOUND_GITHUB_ALLOWED_HOSTS=api.github.com
REPOGUARD_OUTBOUND_LLM_ALLOWED_HOSTS=dashscope.aliyuncs.com,api.openai.com
REPOGUARD_OUTBOUND_NOTIFICATION_ALLOWED_HOSTS=qyapi.weixin.qq.com,oapi.dingtalk.com
REPOGUARD_OUTBOUND_INFRASTRUCTURE_ALLOWED_HOSTS=mysql,rabbitmq
REPOGUARD_OUTBOUND_PRIVATE_NETWORK_ALLOWED_HOSTS=mysql,rabbitmq
REPOGUARD_OUTBOUND_GITHUB_ALLOWED_PORTS=443
REPOGUARD_OUTBOUND_LLM_ALLOWED_PORTS=443
REPOGUARD_OUTBOUND_NOTIFICATION_ALLOWED_PORTS=443
REPOGUARD_OUTBOUND_MYSQL_ALLOWED_PORTS=3306
REPOGUARD_OUTBOUND_RABBITMQ_ALLOWED_PORTS=5671,5672

# Production deployments reject test RabbitMQ vhosts and queue names.
# Run online tests with a separate environment file and isolated containers;
# do not change production APP_* or REPOGUARD_* routing values for testing.

HTTP_PORT_BIND=80
HTTPS_PORT_BIND=443
HEALTH_URL=http://127.0.0.1/actuator/health

# Optional: set this only when migrating from a previous compose deployment.
# The script will run `docker compose ... down` on this file before starting
# docker-compose.prod.yml. Volumes are preserved.
# LEGACY_COMPOSE_FILE=/opt/repoguard/app/docker-compose.ip.yml
# LEGACY_ENV_FILE=/opt/repoguard/app/.env.demo
