logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "repoguard" {
  host             = "tcp://docker-proxy:2375"
  refresh_interval = "5s"
}

discovery.relabel "repoguard" {
  targets = discovery.docker.repoguard.targets

  // Docker discovery emits one target per container per network, so a container
  // bridged onto this network for metrics scraping (see
  // docker-compose.metrics-bridge.yml) would otherwise be tailed twice. Drop the
  // observability-network copy so each container yields exactly one log target.
  // This is a no-op for containers that are not bridged.
  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = "repoguard_observability"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(repoguard-backend|repoguard-backend-worker|repoguard-frontend|repoguard-caddy)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

discovery.relabel "docker_stream" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "repoguard" {
  host             = "tcp://docker-proxy:2375"
  targets          = discovery.relabel.repoguard.output
  labels           = { job = "repoguard-docker" }
  relabel_rules    = discovery.relabel.docker_stream.rules
  refresh_interval = "5s"
  forward_to       = [loki.process.repoguard.receiver]
}

loki.process "repoguard" {
  forward_to = [loki.write.local.receiver]

  // Loki rejects samples older than 168h. Keep a small processing margin
  // when a fresh Alloy data volume first replays existing Docker logs.
  stage.drop {
    older_than          = "167h55m"
    drop_counter_reason = "outside_loki_ingestion_window"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
