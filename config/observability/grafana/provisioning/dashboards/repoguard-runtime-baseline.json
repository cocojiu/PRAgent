{
  "uid": "repoguard-runtime-baseline",
  "title": "RepoGuard Runtime Baseline",
  "description": "仅显示运行证据。LEGACY 为历史待核对记录；无活动时等待和耗时面板可能没有样本。告警只在 Grafana 查看，不配置外部接收器。",
  "tags": [
    "repoguard",
    "metrics",
    "operations"
  ],
  "schemaVersion": 40,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API 与 Worker 采集状态",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "up{job=~\"repoguard-api|repoguard-worker\"}",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "当前告警状态",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "ALERTS{alertstate=~\"pending|firing\"}",
          "legendFormat": "{{alertname}} {{alertstate}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "触发中告警数",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "告警数",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "待核对调用数",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "repoguard_llm_usage_pending{job=\"repoguard-api\"}",
          "legendFormat": "{{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "最早待核对记录年龄",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "repoguard_llm_usage_oldest_age_seconds{job=\"repoguard-api\"}",
          "legendFormat": "{{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "账本指标距上次成功采集",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "time() - repoguard_llm_usage_snapshot_last_success_seconds{job=\"repoguard-api\"}",
          "legendFormat": "采集年龄",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "最近预算拒绝次数",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "sum by (reason) (increase(repoguard_llm_budget_denied_total[5m]))",
          "legendFormat": "{{reason}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "消息等待 P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(repoguard_review_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "P95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "任务平均耗时",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "sum(rate(repoguard_review_task_duration_seconds_sum[5m])) / sum(rate(repoguard_review_task_duration_seconds_count[5m]))",
          "legendFormat": "平均",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "任务失败速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "sum by (category) (rate(repoguard_review_task_failed_total[5m]))",
          "legendFormat": "{{category}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "外部重试速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "sum by (system, category) (rate(repoguard_external_call_retry_total[5m]))",
          "legendFormat": "{{system}} {{category}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "缓存命中率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "sum by (cache) (rate(repoguard_dashboard_cache_access_total{result=\"hit\"}[5m])) / sum by (cache) (rate(repoguard_dashboard_cache_access_total[5m]))",
          "legendFormat": "{{cache}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "JVM 堆占用",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "repoguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "repoguard-prometheus"
          },
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{job}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
