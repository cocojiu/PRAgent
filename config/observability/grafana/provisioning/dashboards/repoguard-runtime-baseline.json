{
  "uid": "repoguard-runtime-baseline",
  "title": "RepoGuard Runtime Baseline",
  "description": "复用日志栈。LEGACY 为历史待核对证据；无活动时等待和耗时面板可能没有样本。告警只在 Grafana 查看。",
  "tags": [
    "repoguard",
    "metrics",
    "operations"
  ],
  "schemaVersion": 40,
  "version": 2,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API 与 Worker 最近心跳",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "last_over_time({container=~\"repoguard-backend|repoguard-backend-worker\"} |= \"operation=runtime_metric_snapshot metric=heartbeat \" | regexp \"dimension=(?P<dimension>[a-z_]+) value=(?P<value>[0-9.eE+-]+)\" | unwrap value | __error__=\"\" [3m])",
          "legendFormat": "{{container}}",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "待核对调用数",
