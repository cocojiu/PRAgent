      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (dimension) (rate_counter({container=~\"repoguard-backend|repoguard-backend-worker\"} |= \"operation=runtime_metric_snapshot metric=budget_denied_total \" | regexp \"dimension=(?P<dimension>[a-z_]+) value=(?P<value>[0-9.eE+-]+)\" | unwrap value | __error__=\"\" [5m]))",
