    {
      "id": 100,
      "title": "当前告警状态",
      "type": "alertlist",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "datasource": "loki",
        "alertInstanceLabelFilter": "{scope=\"repoguard-runtime\"}",
        "showInactiveAlerts": true,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "normal": true,
          "error": true,
