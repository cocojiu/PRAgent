{
  "uid": "repoguard-review-observability",
  "title": "RepoGuard Review Observability",
  "tags": [
    "repoguard",
    "logs",
    "review"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "taskId",
        "type": "textbox",
        "label": "Task ID",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "traceId",
        "type": "textbox",
        "label": "Trace ID",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "operation",
        "type": "custom",
        "label": "Operation",
        "query": "operation=,operation=rabbit_publish,operation=rabbit_consume,operation=review_execute,operation=github_diff_fetch",
        "current": {
          "text": "operation=",
          "value": "operation="
        },
        "options": [
          {
            "selected": true,
            "text": "operation=",
            "value": "operation="
          },
          {
            "selected": false,
            "text": "operation=rabbit_publish",
            "value": "operation=rabbit_publish"
          },
          {
            "selected": false,
            "text": "operation=rabbit_consume",
            "value": "operation=rabbit_consume"
          },
          {
            "selected": false,
            "text": "operation=review_execute",
            "value": "operation=review_execute"
          },
          {
            "selected": false,
            "text": "operation=github_diff_fetch",
            "value": "operation=github_diff_fetch"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Review Chain Logs",
      "description": "Filter API and worker logs by taskId, traceId, and operation. Empty taskId/traceId values match all structured RepoGuard backend logs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"repoguard-backend(-worker)?\"} |= \"taskId=$taskId\" |= \"traceId=$traceId\" |= \"$operation\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Failures",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"repoguard-backend(-worker)?\"} |= \"failureCategory=\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"repoguard-backend(-worker)?\"} |= \"ERROR\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "RabbitMQ Publish / Consume",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"repoguard-backend(-worker)?\"} |~ \"operation=rabbit_(publish|consume)\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "GitHub Diff Fetch",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"repoguard-backend(-worker)?\"} |= \"operation=github_diff_fetch\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Review Execution",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=~\"repoguard-backend(-worker)?\"} |= \"operation=review_execute\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Sampled frontend cancellations",
      "description": "Sum of explicitly cancelled requests in sampled frontend performance batches over the selected time range; unavailable for old log formats.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({container=~\"repoguard-backend(-worker)?\"} |= \"Frontend performance observed\" | regexp \"apiCancelled=(?P<cancelled>[0-9]+) apiFailed=(?P<failed>[0-9]+) apiCompleted=(?P<completed>[0-9]+)\" | unwrap cancelled | __error__=\"\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Sampled frontend failure ratio",
      "description": "failed / (success + failed) in sampled batches. Cancellations are excluded from both numerator and denominator. A zero denominator or missing samples remains unavailable.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({container=~\"repoguard-backend(-worker)?\"} |= \"Frontend performance observed\" | regexp \"apiCancelled=(?P<cancelled>[0-9]+) apiFailed=(?P<failed>[0-9]+) apiCompleted=(?P<completed>[0-9]+)\" | unwrap failed | __error__=\"\" [$__range])) / (sum(sum_over_time({container=~\"repoguard-backend(-worker)?\"} |= \"Frontend performance observed\" | regexp \"apiCancelled=(?P<cancelled>[0-9]+) apiFailed=(?P<failed>[0-9]+) apiCompleted=(?P<completed>[0-9]+)\" | unwrap completed | __error__=\"\" [$__range])) > 0)",
          "refId": "A",
          "queryType": "instant",
          "editorMode": "code"
        }
      ]
    }
  ]
}
