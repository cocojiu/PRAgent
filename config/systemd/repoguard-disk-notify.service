[Unit]
Description=Send explicitly enabled RepoGuard host disk alerts to DingTalk
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/repoguard/scripts/disk-notify.py --root /opt/repoguard --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/repoguard/.deploy-state
MemoryMax=128M
CPUQuota=10%
TimeoutStartSec=45
