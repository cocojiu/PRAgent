{$REPOGUARD_FRONTEND_SERVER_NAME} {
    log {
        output stdout
        format json
    }
    encode zstd gzip

    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    handle {
        reverse_proxy frontend:8080
    }
}

:80 {
    log {
        output stdout
        format json
    }

    @containerHealth path /healthz
    handle @containerHealth {
        respond "ok" 200
    }

    @canonicalHost host {$REPOGUARD_FRONTEND_SERVER_NAME}
    handle @canonicalHost {
        # REPOGUARD_FRONTEND_SERVER_NAME may contain multiple host names. Use
        # the matched request host in the target so Caddy never tokenizes a
        # space-separated host list as part of the redirection arguments.
        redir https://{http.request.host}{uri} permanent
    }

    handle {
        respond "HTTPS canonical host required" 421
    }
}
