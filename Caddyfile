{$REPOGUARD_FRONTEND_SERVER_NAME} {
    log {
        output stdout
        format json
    }
    encode zstd gzip
    reverse_proxy frontend:8080
}

:80 {
    log {
        output stdout
        format json
    }
    @health path /actuator/health
    handle @health {
        reverse_proxy frontend:8080
    }
    handle {
        respond "HTTPS canonical host required" 421
    }
}
