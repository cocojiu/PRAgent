{
    # Explicit HTTP routing below owns redirects; certificate automation stays enabled.
    auto_https disable_redirects
}

# Operator-owned state stays in the existing Caddy data volume across recreation.
(publication_maintenance) {
    @publicationMaintenance {
        method POST
        path_regexp publication (^|/)github-comments([/;]|$)
        file {
            root /data/repoguard-maintenance
            try_files publication-blocked
        }
    }
    handle @publicationMaintenance {
        header {
            Cache-Control no-store
            Content-Type "application/json; charset=utf-8"
            Retry-After 60
            X-RepoGuard-Publication-Maintenance true
        }
        respond `{"success":false,"code":"SERVICE_UNAVAILABLE","message":"GitHub 发布维护中，请稍后重试"}` 503
    }
}

{$REPOGUARD_FRONTEND_SERVER_NAME} {
    log {
        output stdout
        format json
    }
    encode zstd gzip

    import publication_maintenance

    @health path /healthz
    handle @health {
        respond "ok" 200
    }

    handle {
        reverse_proxy frontend:8080
    }
}

:80 {
    log {
        output stdout
        format json
    }

    import publication_maintenance

    @containerHealth path /healthz
    handle @containerHealth {
        respond "ok" 200
    }

    @canonicalHost host {$REPOGUARD_FRONTEND_SERVER_NAME}
    handle @canonicalHost {
        # REPOGUARD_FRONTEND_SERVER_NAME may contain multiple host names. Use
        # the matched request host in the target so Caddy never tokenizes a
        # space-separated host list as part of the redirection arguments.
        redir https://{http.request.host}{uri} permanent
    }

    handle {
        respond "HTTPS canonical host required" 421
    }
}
