{
  "name": "repoguard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "node scripts/generate-openapi-client.mjs",
    "check:api-generated": "node scripts/generate-openapi-client.mjs --check",
    "typecheck": "npm run check:api-generated && vue-tsc -b",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "test:unit": "vitest run",
    "test:e2e": "vitest run src/e2e",
    "quality": "npm run typecheck && npm run lint && npm run test:unit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
