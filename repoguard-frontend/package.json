{
  "name": "repoguard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "node scripts/generate-openapi-client.mjs",
    "check:api-generated": "node scripts/generate-openapi-client.mjs --check",
    "typecheck": "npm run check:api-generated && vue-tsc -b",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"scripts/**/*.mjs\"",
    "test:unit": "vitest run",
    "test:route-smoke": "vitest run src/smoke",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "quality": "npm run typecheck && npm run lint && npm run test:coverage",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.3",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
